<% include YouWillLikeIT\\CareHome\\PortalHead %>
<section class="ch-card mt-6 p-6 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">$Bed.FullTitle</p>
    <h1 class="mt-2 text-2xl font-bold"><%t CareHomePortal.BED_FREE "Krevet je slobodan" %></h1>
    <p class="mt-2 text-slate-600"><%t CareHomePortal.BED_FREE_HINT "Ovom krevetu trenutno nije dodijeljen štićenik." %></p>
    <a href="$Link" class="ch-btn-ghost mt-6"><%t CareHomePortal.BACK_HOME "Na početnu" %></a>
</section>
<% include YouWillLikeIT\\CareHome\\ScanButton %>
<% include YouWillLikeIT\\CareHome\\PortalFoot %>
